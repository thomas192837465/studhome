VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# KoraPay — set this as a Vercel Project Environment Variable (Settings > Environment
# Variables), NOT in this file. It is read only by the serverless functions in /api,
# never bundled into the frontend, so it must NOT be prefixed with VITE_.
# KORAPAY_SECRET_KEY=sk_test_xxxxx  (sandbox) / sk_live_xxxxx (production)

# CinetPay — also Vercel-only, never in this file. Used by api/cinetpay/*.js
# as a second payment gateway option alongside KoraPay.
# CINETPAY_API_KEY=your-cinetpay-api-key
# CINETPAY_SITE_ID=your-cinetpay-site-id

# Twilio — also set as Vercel Project Environment Variables only, never in
# this file. Used by api/twilio/send-code.js and verify-code.js for custom
# WhatsApp 2FA / signup verification (plain Messaging API, not Twilio
# Verify — creating a Verify Service is gated behind an upgraded/paid
# Twilio account).
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
#
# WhatsApp-enabled sender. In the Sandbox this is always
# whatsapp:+14155238886 (freeform text works, but each recipient must first
# "join" the sandbox from their own WhatsApp). In production this is your
# approved WhatsApp Sender number (Console > Messaging > Senders > WhatsApp
# senders) — the "whatsapp:" prefix is added automatically if you omit it.
# TWILIO_WHATSAPP_FROM_NUMBER=whatsapp:+14155238886
#
# Content Template SID (starts with HX) for the approved "authentication"
# template used to send OTP codes outside the Sandbox — Meta requires an
# approved template for any business-initiated WhatsApp message. Leave
# unset while testing against the Sandbox; the code falls back to a
# freeform message when this isn't set.
# TWILIO_WHATSAPP_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase service_role key — also Vercel-only, never in this file. Used by
# api/admin/invite.js, revoke.js, and api/twilio/*.js + api/email/*.js for
# privileged, RLS-bypassing operations that the anon key cannot perform.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Brevo — also Vercel-only, never in this file. Used by
# api/notify/listing-status.js and api/email/send-code.js (email 2FA).
# BREVO_API_KEY=your-brevo-api-key
# BREVO_SENDER_EMAIL=noreply@yourdomain.com
# BREVO_SENDER_NAME=StudHome
