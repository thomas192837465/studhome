VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# KoraPay — set this as a Vercel Project Environment Variable (Settings > Environment
# Variables), NOT in this file. It is read only by the serverless functions in /api,
# never bundled into the frontend, so it must NOT be prefixed with VITE_.
# KORAPAY_SECRET_KEY=sk_test_xxxxx  (sandbox) / sk_live_xxxxx (production)

# Twilio Verify — also set as Vercel Project Environment Variables only, never
# in this file. Used by api/twilio/send-code.js and verify-code.js for custom
# SMS 2FA (bypasses Supabase's paid Advanced MFA Phone add-on).
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
