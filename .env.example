VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# KoraPay — set this as a Vercel Project Environment Variable (Settings > Environment
# Variables), NOT in this file. It is read only by the serverless functions in /api,
# never bundled into the frontend, so it must NOT be prefixed with VITE_.
# KORAPAY_SECRET_KEY=sk_test_xxxxx  (sandbox) / sk_live_xxxxx (production)
