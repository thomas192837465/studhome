VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# NotchPay — set these as Vercel Project Environment Variables (Settings > Environment
# Variables), NOT in this file. They are read only by the serverless functions in /api,
# never bundled into the frontend, so they must NOT be prefixed with VITE_.
# NOTCHPAY_PUBLIC_KEY=pk_test.xxxxx  (sandbox) / pk_live.xxxxx (production)
# NOTCHPAY_SECRET_KEY=sk_test.xxxxx  (sandbox) / sk_live.xxxxx (production)
