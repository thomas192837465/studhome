VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# KoraPay — set this as a Vercel Project Environment Variable (Settings > Environment
# Variables), NOT in this file. It is read only by the serverless functions in /api,
# never bundled into the frontend, so it must NOT be prefixed with VITE_.
# KORAPAY_SECRET_KEY=sk_test_xxxxx  (sandbox) / sk_live_xxxxx (production)

# Twilio — also set as Vercel Project Environment Variables only, never in
# this file. Used by api/twilio/send-code.js and verify-code.js for custom
# SMS 2FA (plain Messaging API, not Twilio Verify — creating a Verify
# Service requires an upgraded/paid Twilio account).
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_FROM_NUMBER=+1xxxxxxxxxx  (your Twilio phone number, E.164 format)

# Supabase service_role key — also Vercel-only, never in this file. Used by
# api/admin/invite.js, revoke.js, and api/twilio/*.js for privileged,
# RLS-bypassing operations that the anon key cannot perform.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
